OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GITHUB_MODELS_TOKEN=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
COHERE_API_KEY=
HF_TOKEN=

# Optional: turns on the agent's web_search tool (Tavily free plan).
TAVILY_API_KEY=
